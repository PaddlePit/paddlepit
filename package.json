{
  "name": "paddlepit",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm run dev --workspace=web-app",
    "dev:admin": "npm run dev --workspace=admin-app",
    "build:web": "npm run build --workspace=web-app",
    "build:admin": "npm run build --workspace=admin-app"
  },
  "workspaces": [
    "apps/web-app",
    "apps/admin-app"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
