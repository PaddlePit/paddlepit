{
  "name": "paddlepit",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:admin\"",
    "dev:web": "pnpm --filter ./apps/web-app dev",
    "dev:admin": "pnpm --filter ./apps/admin-app run dev",
    "build:web": "pnpm --filter ./apps/web-app run build",
    "build:admin": "pnpm --filter ./apps/admin-app run build"
  },
  "workspaces": [
    "apps/web-app",
    "apps/admin-app"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
