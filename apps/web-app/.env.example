# Booking backend configuration for the PaddlePit web app.
#
# The booking UI is "backend-ready": every data flow goes through one service
# interface (services/bookingService.ts) selected in services/index.ts.
# Flip VITE_USE_MOCK=false and point VITE_API_BASE_URL at the real API once the
# 5 endpoints in BACKEND_INTEGRATION.md are implemented.

# Base URL of the booking API, e.g. https://api.paddlepit.ph/v1
VITE_API_BASE_URL=

# true  → deterministic in-browser mock (no server needed, default)
# false → real HTTP client against VITE_API_BASE_URL
VITE_USE_MOCK=true

# NOTE for Next.js builds: prefix with NEXT_PUBLIC_ instead (or in addition),
# since `next build` inlines NEXT_PUBLIC_* at build time:
#   NEXT_PUBLIC_API_BASE_URL=
#   NEXT_PUBLIC_USE_MOCK=true