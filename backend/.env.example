# ============================================================================
# PaddlePit Application Configuration
# Copy this file to .env and fill in with your actual values
# ============================================================================

# APPLICATION SETTINGS
# ============================================================================
APP_NAME=PaddlePit API
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development  # Options: development, staging, production

# DATABASE (DynamoDB)
# ============================================================================
DB_REGION_NAME=us-east-1
DB_ACCESS_KEY_ID=your_aws_access_key_here
DB_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# For local DynamoDB development (uncomment if using local DynamoDB)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# AWS GENERAL
# ============================================================================
AWS_REGION=us-east-1

# S3 CONFIGURATION
# ============================================================================
S3_BUCKET_NAME=paddlepit-dev-uploads
S3_UPLOADS_DIR=uploads

# SES CONFIGURATION (Email Service)
# ============================================================================
SES_SENDER_EMAIL=noreply@paddlepit.local
SES_REGION_NAME=us-east-1

# PayMongo API CONFIGURATION
# Get these from https://dashboard.paymongo.com/settings/developers
# ============================================================================
# Secret Key (used for server-side API calls)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# Public Key (used for client-side operations)
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here

# Webhook Secret (used to verify webhook signatures)
# Get from: Dashboard → Settings → Webhooks → [Webhook Name] → Signing Secret
PAYMONGO_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# GOOGLE OAUTH CONFIGURATION
# ============================================================================
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT CONFIGURATION (Authentication)
# ============================================================================
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# API SETTINGS
# ============================================================================
API_DOCS_ENABLED=True
API_REDOC_ENABLED=True
